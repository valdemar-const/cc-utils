# .cpm — generated by `cpm init`. Tool orientation; CMake does NOT read this.
# Regenerate by re-running `cpm init --force` with updated --dir/--scripts/--patches.
[paths]
scripts = "build/cmake/scripts"   # vendored CPM.cmake lives here (→ `cpm update`)
module  = "build/cmake/modules/3rdparty"      # deps.toml + engine + Find<Name>.cmake
patches = "build/patches"   # patch root (→ CPM_PATCH_PREFIX)
